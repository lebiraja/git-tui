/* ===================================================================
   GitPulse — Textual CSS
   Minimal dark dashboard theme.

   Palette tokens:
     background #0b0f14   panel #111827   border #1f2937
     text       #d1d5db   muted #6b7280   accent #8b5cf6
     green      #22c55e   yellow #f59e0b  red    #ef4444
   =================================================================== */

/* ---------- Global ---------- */
Screen {
    background: #0b0f14;
    color: #d1d5db;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: #1f2937;
    scrollbar-color-hover: #8b5cf6;
    scrollbar-color-active: #8b5cf6;
    scrollbar-background: #0b0f14;
    scrollbar-background-hover: #0b0f14;
    scrollbar-background-active: #0b0f14;
}

/* ---------- Layout ---------- */
#app-grid {
    layout: horizontal;
    height: 1fr;
}

#sidebar-column {
    width: 38;
    min-width: 30;
    max-width: 48;
    background: #111827;
    border-right: solid #1f2937;
}

#sidebar-container {
    width: 100%;
    height: 1fr;
    background: #111827;
}

#main-panel {
    width: 1fr;
    background: #0b0f14;
}

/* ---------- App header ---------- */
AppHeader {
    dock: top;
    height: 1;
    background: #111827;
    border-bottom: solid #1f2937;
    layout: horizontal;
}

#header-logo {
    width: auto;
    padding: 0 2;
    color: #d1d5db;
}

#header-tabs {
    width: 1fr;
    layout: horizontal;
    align: center middle;
}

HeaderTab {
    width: auto;
    height: 1;
    padding: 0 2;
    color: #6b7280;
}

HeaderTab:hover {
    color: #d1d5db;
}

HeaderTab.-active {
    color: #8b5cf6;
    text-style: bold;
}

#header-actions {
    width: auto;
    padding: 0 2;
    color: #6b7280;
}

/* ---------- Sidebar ---------- */
#sidebar-title {
    dock: top;
    width: 100%;
    height: 1;
    content-align: left middle;
    text-style: bold;
    color: #d1d5db;
    background: #111827;
    padding: 0 1;
}

#search-input {
    dock: top;
    width: 100%;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: #0b0f14;
    color: #d1d5db;
    border: solid #1f2937;
}

#search-input:focus {
    border: solid #8b5cf6;
}

Input:focus {
    border: solid #8b5cf6;
}

#repo-list-header {
    dock: top;
    width: 100%;
    height: 1;
    background: #0b0f14;
    color: #6b7280;
    padding: 0 1;
}

#repo-list {
    background: #111827;
}

RepoListItem {
    height: auto;
    background: #111827;
    padding: 0 1;
}

RepoListItem:hover {
    background: #1f2937;
}

#repo-list:focus > RepoListItem.--highlight {
    background: #1f2937;
}

/* ---------- Main panel / content switcher ---------- */
#main-content {
    width: 1fr;
    height: 1fr;
    background: #0b0f14;
}

TabbedContent {
    background: #0b0f14;
    height: 1fr;
}

ContentSwitcher {
    background: #0b0f14;
    height: 1fr;
}

.content-pane {
    background: #0b0f14;
    padding: 1 1;
    height: 1fr;
}

TabPane {
    background: #0b0f14;
    padding: 1 2;
    height: 1fr;
}

Tabs {
    background: #111827;
    dock: top;
    height: 1;
}

Tab {
    color: #6b7280;
    background: #111827;
    padding: 0 2;
}

Tab:hover {
    color: #d1d5db;
}

Tab.-active {
    color: #8b5cf6;
    background: #0b0f14;
    text-style: bold;
}

Underline > .underline--bar {
    color: #8b5cf6;
}

/* ---------- DataTable ---------- */
DataTable {
    background: #0b0f14;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #111827;
    color: #6b7280;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1f2937;
    color: #d1d5db;
}

DataTable > .datatable--even-row {
    background: #0b0f14;
}

DataTable > .datatable--odd-row {
    background: #111827;
}

/* ---------- Status / panels ---------- */
#status-summary {
    height: auto;
    background: #0b0f14;
    padding: 0 1;
}

#status-file-list {
    height: 1fr;
    background: #0b0f14;
}

.panel {
    background: #111827;
    border: solid #1f2937;
    border-title-color: #6b7280;
    border-title-align: left;
}

#status-hints,
#commits-hints,
#branch-hints,
#diff-footer,
#remotes-hints,
#tree-hints {
    height: 1;
    dock: bottom;
    background: #111827;
    color: #6b7280;
    padding: 0 1;
    border-top: solid #1f2937;
}

StatusFileItem {
    height: 1;
    padding: 0 1;
    background: #0b0f14;
}

StatusFileItem:hover {
    background: #1f2937;
}

#status-file-list:focus > StatusFileItem.--highlight {
    background: #1f2937;
}

/* ---------- Status pane (redesigned) ---------- */
#repo-header {
    height: 1;
    background: #0b0f14;
    color: #d1d5db;
    padding: 0 1;
}

SummaryCards {
    height: 4;
    layout: horizontal;
    background: #0b0f14;
}

SummaryCard {
    width: 1fr;
    height: 4;
    background: #111827;
    border: solid #1f2937;
    border-title-color: #6b7280;
    border-title-align: left;
    padding: 0 1;
    margin: 0 1 0 0;
}

#status-body {
    layout: horizontal;
    height: 1fr;
}

#status-workspace {
    width: 1fr;
    height: 1fr;
}

#status-rightbar {
    width: 34;
    min-width: 26;
    height: 1fr;
    layout: vertical;
}

#status-rightbar > .panel {
    height: 1fr;
    margin: 0 0 1 0;
}

.empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: #6b7280;
}

/* ---------- Diff tab ---------- */
#diff-layout {
    height: 1fr;
    layout: horizontal;
}

#diff-file-panel {
    width: 28;
    min-width: 20;
    background: #111827;
    border-right: solid #1f2937;
}

#diff-file-header {
    height: 1;
    background: #111827;
    padding: 0 1;
    color: #6b7280;
    text-style: bold;
}

#diff-file-list {
    height: 1fr;
    background: #111827;
}

DiffFileItem {
    height: 1;
    padding: 0 1;
    background: #111827;
}

DiffFileItem:hover {
    background: #1f2937;
}

#diff-file-list:focus > DiffFileItem.--highlight {
    background: #1f2937;
}

#diff-view-panel {
    width: 1fr;
    background: #0b0f14;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: auto;
}

#diff-content {
    background: #0b0f14;
    height: auto;
}

/* ---------- Remotes + Tree ---------- */
#remotes-scroll {
    width: 100%;
    height: 1fr;
    background: #0b0f14;
    padding: 1 1;
}

#remotes-content {
    background: #0b0f14;
    height: auto;
}

#commits-layout {
    height: 1fr;
    layout: vertical;
}

#commits-graph-scroll {
    width: 100%;
    height: 10;
    background: #111827;
    border: solid #1f2937;
    padding: 0 1;
    overflow-x: auto;
    overflow-y: auto;
}

#commits-graph {
    height: auto;
    background: #111827;
}

#tree-widget {
    width: 100%;
    height: 1fr;
    background: #0b0f14;
    padding: 0 1;
}

Tree > .tree--guides {
    color: #1f2937;
}

Tree > .tree--guides-hover {
    color: #8b5cf6;
}

Tree > .tree--guides-selected {
    color: #8b5cf6;
}

Tree > .tree--cursor {
    background: #1f2937;
    color: #d1d5db;
}

Tree > .tree--highlight {
    background: #1f2937;
}

/* ---------- Branch list ---------- */
#branch-list {
    background: #0b0f14;
    height: 1fr;
}

BranchListItem {
    height: 1;
    padding: 0 1;
    background: #0b0f14;
}

BranchListItem:hover {
    background: #1f2937;
}

#branch-list:focus > BranchListItem.--highlight {
    background: #1f2937;
}

/* ---------- Footer ---------- */
Footer {
    background: #111827;
    color: #6b7280;
}

Footer > .footer--key {
    color: #8b5cf6;
    text-style: bold;
    background: #111827;
}

Footer > .footer--description {
    color: #6b7280;
}

/* ---------- Buttons ---------- */
Button {
    background: #1f2937;
    color: #d1d5db;
}

Button:focus {
    text-style: bold;
}

Button.-primary {
    background: #8b5cf6;
    color: #0b0f14;
}

Button.-success {
    background: #22c55e;
    color: #0b0f14;
}

Button.-warning {
    background: #f59e0b;
    color: #0b0f14;
}

Button.-error {
    background: #ef4444;
    color: #0b0f14;
}

/* ---------- Fleet status strip ---------- */
FleetStatus {
    height: 1;
    background: #111827;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

FleetStatus > Static#fleet-label {
    width: auto;
    color: #6b7280;
    margin-right: 1;
}

FleetChip {
    width: auto;
    height: 1;
    padding: 0 1;
    color: #6b7280;
}

FleetChip:hover {
    color: #d1d5db;
}

FleetChip.-active-filter {
    color: #8b5cf6;
    text-style: bold;
}

/* ---------- Empty message ---------- */
.empty-message {
    color: #6b7280;
    text-style: italic;
    padding: 2;
    content-align: center middle;
    width: 100%;
    height: 100%;
}
